<!--
  Kiwi Browser — color overrides for the monochrome UI theme.
  Raw hex values MUST NOT be added here; always reference @color/kiwi_* from
  kiwi_monochrome_colors.xml so the palette has a single source of truth.
  See: res/values/kiwi_monochrome_colors.xml
-->

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Please see src/ui/android/java/res/values/colors.xml for the shared common colors. -->

    <!-- ── Action bars / status bar ──────────────────────────────────── -->
    <!-- Dark action bar used by ManageSpace activity — set to toolbar surface -->
    <color name="dark_action_bar_color">@color/kiwi_bg_toolbar</color>
    <!-- Status bar behind system icons -->
    <color name="dark_status_bar_color">@color/kiwi_status_bar</color>

    <!-- ── Tab Switcher ───────────────────────────────────────────────── -->
    <color name="tab_switcher_background">@color/kiwi_tab_switcher_bg</color>
    <color name="accessibility_tab_switcher_list_item">@color/kiwi_tab_card_bg</color>

    <!-- ── App menu ───────────────────────────────────────────────────── -->
    <!-- Error/update text stays red — intentionally NOT overridden to monochrome -->
    <color name="update_menu_item_text_color">@color/default_red</color>

    <!-- ── Distilled Page Prefs ───────────────────────────────────────── -->
    <color name="distilled_page_prefs_selected">@color/kiwi_text_secondary</color>
    <color name="distilled_page_prefs_unselected_baseline">@color/kiwi_bg_elevated</color>

    <!-- ── Compositor Tab Titles ─────────────────────────────────────── -->
    <color name="compositor_tab_title_bar_text">@color/kiwi_text_primary</color>
    <color name="compositor_tab_title_bar_text_incognito">@color/kiwi_text_primary</color>

    <!-- ── Account Signin ────────────────────────────────────────────── -->
    <macro name="signin_head_background">@color/kiwi_bg_surface</macro>
    <macro name="signin_body_background">@color/kiwi_bg_surface</macro>
    <color name="signin_header_animation_background">@color/kiwi_bg_elevated</color>
    <color name="signin_header_animation_line_light">@color/kiwi_toolbar_border</color>
    <color name="signin_header_animation_line_dark">@color/kiwi_divider</color>
    <color name="signin_header_animation_laptop_screen">@color/kiwi_bg_surface</color>

    <!-- ── NTP / Home sheet ───────────────────────────────────────────── -->
    <color name="ntp_bg_incognito">@color/kiwi_bg_primary</color>

    <!-- ── Incognito NTP ──────────────────────────────────────────────── -->
    <color name="incognito_emphasis">@color/kiwi_text_primary</color>

    <!-- ── Overlay Panel ─────────────────────────────────────────────── -->
    <macro name="overlay_panel_bar_background_color">@color/kiwi_bg_toolbar</macro>

    <!-- ── Find in Page ──────────────────────────────────────────────── -->
    <color name="find_in_page_query_white_color">@color/kiwi_text_primary</color>
    <color name="find_in_page_query_incognito_hint_color">@color/kiwi_text_secondary</color>
    <!-- Error color stays red for usability — do not override -->
    <color name="find_in_page_failed_results_status_color">@color/default_red</color>
    <color name="find_in_page_query_default_hint_color">@color/kiwi_text_secondary</color>

    <!-- ── App Window Background ─────────────────────────────────────── -->
    <color name="window_background_color">@color/kiwi_bg_primary</color>
    <!-- Bottom system navigation bar -->
    <color name="navigation_bar_color">@color/kiwi_nav_bar</color>

    <!-- ── Bookmark Widget ────────────────────────────────────────────── -->
    <color name="bookmark_widget_pressed_highlight">@color/kiwi_overlay_pressed</color>
    <color name="bookmark_widget_background">@color/kiwi_bg_surface</color>

    <!-- ── History Navigation Bubble ─────────────────────────────────── -->
    <!-- Arrow renders on web content — keep black -->
    <color name="navigation_bubble_arrow">@android:color/black</color>

    <!-- ── Scrollbar ─────────────────────────────────────────────────── -->
    <color name="default_scroll_thumb">@color/kiwi_text_disabled</color>

    <!-- ── Explore Sites ─────────────────────────────────────────────── -->
    <color name="explore_sites_dense_tile_background_color">#00000000</color>

    <!-- ── Offline Indicator ─────────────────────────────────────────── -->
    <color name="offline_indicator_offline_color">@color/kiwi_bg_primary</color>

    <!-- ── Miscellaneous ─────────────────────────────────────────────── -->
    <color name="media_viewer_bg">@color/kiwi_bg_primary</color>
    <color name="image_viewer_bg">@color/kiwi_bg_surface</color>
    <color name="thumbnail_placeholder_on_primary_bg" tools:ignore="UnusedResources">@color/kiwi_bg_elevated</color>
    <!-- Tab layout selected indicator — white accent -->
    <macro name="tab_layout_selected_tab_color">@color/kiwi_accent</macro>
    <!-- Web notification text -->
    <color name="web_notification_text">@color/kiwi_text_secondary</color>

</resources>
