<org.chromium.chrome.browser.ntp.IncognitoNewTabPageView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ntp_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:contentDescription="@string/accessibility_new_incognito_tab_page">

    <org.chromium.chrome.browser.ntp.NewTabPageScrollView
        android:id="@+id/ntp_scrollview"
        android:background="@color/ntp_bg_incognito"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdgeLength="9dp"
        android:fillViewport="false"
        android:requiresFadingEdge="vertical" >

        <!-- The layout resource for this ViewStub is NOT set here — it is injected at runtime.
             - When INCOGNITO_NTP_REVAMP flag is DISABLED: inflates @layout/incognito_description_layout
               (root view: LegacyIncognitoDescriptionView)
             - When INCOGNITO_NTP_REVAMP flag is ENABLED:  inflates @layout/revamped_incognito_description_layout
               (root view: RevampedIncognitoDescriptionView)
             Both files are intentionally retained. Do NOT remove either without removing the other. -->
        <ViewStub
            android:id="@+id/incognito_description_layout_stub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </org.chromium.chrome.browser.ntp.NewTabPageScrollView>

</org.chromium.chrome.browser.ntp.IncognitoNewTabPageView>
